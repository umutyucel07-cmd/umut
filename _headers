/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Sürüm numarası dosya adında — içerik asla değişmez, bir yıl önbelleklenebilir.
# Kütüphane güncellenirse DOSYA ADI da değişir, bayat kopya riski yoktur.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# İç belgeler yanlışlıkla erişilebilir kalırsa hiç değilse dizine girmesin.
# Asıl koruma _redirects içindeki 404 kurallarıdır; bu ikinci katman.
/*.md
  X-Robots-Tag: noindex, nofollow, noarchive
/tools/*
  X-Robots-Tag: noindex, nofollow, noarchive
