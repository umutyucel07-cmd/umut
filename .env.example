# UYARI: Bu bir ORNEK dosyadir ve depo PUBLIC'tir.
# Buraya hicbir gercek deger yazilmaz - yalniz anahtar adi durur.
# Gercek degerler Cloudflare Pages panosunda tanimlanir (sir).

#
# ERISIM KODU / MÜVEKKIL PORTALI — canli tasarim (13.08.2026 sonrasi)
# ---------------------------------------------------------------
# ESKI tasarim "KODLAR" ortam degiskeninde 472 muvekkilin {ad, tel, kod}
# listesini DUZ METIN tutuyordu. AKTIF TASARIM bunu KULLANMAZ:
#   · kodlar ve muvekkiller KV'de yalniz SHA-256 ozeti olarak saklanir (KOD_KV)
#   · dogrulama sunucuda (functions/api/giris.js), client'ta degil
#   · kod talebi (functions/api/kod-talebi.js) eklestigi kodu yalniz kayitli
#     WhatsApp numarasina gonderir, hicbir yerde duz metin tutmaz
# Ornek .env: KODLAR / KODLAR_SECRET YOKTUR. Icerilirse ESKI/GUVENSIZ dir.

# Cloudflare Pages environment variables (set in Cloudflare dashboard)
# WhatsApp Cloud API (Meta) — kod gonderimi + otomatik teyit
WA_TOKEN=
WA_PHONE_ID=
# Webhook dogrulama jetonu (asla sabit yedek yok — NEDEN-KARANTINADA.md)
WA_VERIFY_TOKEN=
VERIFY_TOKEN=

# KOD_KV binding adi (Pages -> -> Functions -> KV baglantisi).
# Not: kod ozetleri / sys:dizin / sys:biber bu KV namespace'inde durur.
# Baglanti adi, functions/api/*.js icindeki env.KOD_KV ile AYNI olmali.
KOD_KV=

# Instagram callback / Worker ERISIM_TOKEN'i (Worker ortaminda, Pages'te degil).
# Worker = muddy-hat-f441; Instagram webhook dogrudan ona gider.
ERISIM_TOKEN=
META_APP_ID=

